{
  "name": "SimRun",
  "version": 1,
  "packageVersion": "0.1.0",
  "purpose": "Local-first running and cycling route planning and explicitly simulated GPX activities",
  "entrypoint": "public/index.html",
  "sourceEntrypoint": "src/main.ts",
  "builtEntrypoint": "dist/index.html",
  "framework": "Native TypeScript / DOM / browser ES modules",
  "packageManager": "npm",
  "nodeVersion": ">=20",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --host 0.0.0.0 --port 5173",
  "testCommand": "npm test",
  "outputDirectory": "dist",
  "persistence": ["IndexedDB", "localStorage"],
  "storageFallback": "Explicitly labeled session-only memory",
  "requiresAuthentication": false,
  "requiresDatabase": false,
  "requiresCloudDatabase": false,
  "requiresPaidApis": false,
  "requiresSecrets": false,
  "externalServices": [
    {"purpose":"map", "provider":"OpenFreeMap / OpenStreetMap / OpenMapTiles", "endpoint":"https://tiles.openfreemap.org/styles/liberty", "replaceable":true},
    {"purpose":"map-renderer-assets", "provider":"unpkg / MapLibre GL JS 5.6.1", "endpoint":"https://unpkg.com/maplibre-gl@5.6.1/dist/", "replaceable":true, "optionalLocalVendoringCommand":"npm run vendor", "bundledInInitialSnapshot":false},
    {"purpose":"routing", "provider":"FOSSGIS public Valhalla", "endpoint":"https://valhalla1.openstreetmap.de/route", "replaceable":true},
    {"purpose":"elevation", "provider":"FOSSGIS public Valhalla", "endpoint":"https://valhalla1.openstreetmap.de/height", "replaceable":true},
    {"purpose":"geocoding", "provider":"Public Nominatim", "endpoint":"https://nominatim.openstreetmap.org/search", "replaceable":true, "enabledByDefault":false, "policy":"https://operations.osmfoundation.org/policies/nominatim/"}
  ],
  "sites": {"target":"ChatGPT Sites", "privatePreviewFirst":true, "runtimeVerified":false, "suggestedHosting":"static-directory"},
  "repository": {"provider":"GitHub", "repo":"exterminatorrat/simrun", "branch":"main"},
  "handoff": {"document":"CHATGPT-SITES-HANDOFF.md", "buildInfo":"BUILD_INFO.json", "integrity":"SOURCE_HASHES.json", "archive":"simrun-sites-handoff.zip"}
}
