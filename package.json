{
  "name": "simrun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first route planning and explicitly simulated GPX activities",
  "engines": {"node": ">=20"},
  "scripts": {
    "dev": "node scripts/serve.mjs",
